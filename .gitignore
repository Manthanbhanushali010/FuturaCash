# Secrets. Deny every .env variant, then re-allow only the committed template — so a new
# .env.production or .env.staging is ignored by default rather than by remembering to
# add it. The template must stay placeholder-only; real values never leave the machine.
.env
.env.*
!.env.example

# Provider token stores — live credentials for real accounting/banking orgs.
.xero-tokens.local.json
*.tokens.local.json
.recovered-sessions/
