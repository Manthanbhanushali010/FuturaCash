# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cashflow?schema=public"

# Auth (WorkOS or Auth0)
WORKOS_API_KEY=""
WORKOS_CLIENT_ID=""

# Xero (OAuth2) — https://developer.xero.com/app/manage
# Create a "Web app", set the redirect URI below on the app, and use the Demo Company (UK)
# when you authorise. Scopes are read-only and defined in integrations/xero/config.ts.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI="http://localhost:3000/api/xero/callback"

# Starling (personal access token — your own account, for the spike)
STARLING_PERSONAL_TOKEN=""

# Open Banking aggregator (TrueLayer / Yapily)
AGGREGATOR_CLIENT_ID=""
AGGREGATOR_CLIENT_SECRET=""

# Never commit a real .env. Secrets live in a secret manager in non-local envs.
