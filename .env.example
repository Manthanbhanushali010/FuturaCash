# Database
#
# DATABASE_URL is the APPLICATION connection and MUST use a role without the BYPASSRLS
# attribute (we use `futura_app`). A role with BYPASSRLS ignores every row-level security
# policy, and tenant isolation silently stops working — no error, no failing test.
# On Neon this is the POOLED host (contains "-pooler").
DATABASE_URL="postgresql://futura_app:password@host-pooler.example.neon.tech/neondb?sslmode=require"
#
# DIRECT_DATABASE_URL is for MIGRATIONS ONLY and uses the database owner. Not pooled:
# Prisma Migrate takes an advisory lock, which transaction-mode pooling does not support.
DIRECT_DATABASE_URL="postgresql://neondb_owner:password@host.example.neon.tech/neondb?sslmode=require"

# Which tenant this deployment acts as, until WorkOS provides it from the session.
APP_TENANT_ID="futura-dev-tenant"

# AES-256-GCM key for OAuth tokens at rest — 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes existing ProviderTokenGrant rows undecryptable, forcing every tenant
# to re-authorise, unless the previous key is retained for its keyVersion.
TOKEN_ENCRYPTION_KEY=""

# Auth (WorkOS or Auth0)
WORKOS_API_KEY=""
WORKOS_CLIENT_ID=""

# Xero (OAuth2) — https://developer.xero.com/app/manage
# Create a "Web app", set the redirect URI below on the app, and use the Demo Company (UK)
# when you authorise. Scopes are read-only and defined in integrations/xero/config.ts.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI="http://localhost:3000/api/xero/callback"

# Starling (personal access token — your own account, for the spike)
STARLING_PERSONAL_TOKEN=""

# Open Banking aggregator (TrueLayer / Yapily)
AGGREGATOR_CLIENT_ID=""
AGGREGATOR_CLIENT_SECRET=""

# Never commit a real .env. In deployed environments these live in the platform's env store;
# rotating per-tenant OAuth tokens live encrypted in Postgres (see context/architecture.md).
