generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled endpoint (PgBouncer, transaction mode) for application queries.
  url       = env("DATABASE_URL")
  // Direct endpoint for migrations. Prisma Migrate takes a Postgres advisory lock, which
  // transaction-mode pooling does not support, so DDL must bypass the pooler.
  directUrl = env("DIRECT_DATABASE_URL")
}

// Every tenant-owned row carries tenantId. Row-Level Security is enforced in the database
// (see prisma/migrations/*_init_with_rls) so isolation cannot be bypassed in app code —
// invariant #3. Policies match `tenantId` against `current_setting('app.tenant_id')`, which
// the application must set per transaction; see the migration's header comment for why it is
// transaction-scoped rather than session-scoped.

model Tenant {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())
  users       User[]
  accounts    BankAccount[]
  tokenGrants ProviderTokenGrant[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([tenantId])
}

enum Provider {
  STARLING
  XERO
  AGGREGATOR
  MANUAL
}

model BankAccount {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  provider     Provider
  externalId   String
  name         String
  currency     String        // ISO 4217, e.g. "GBP"
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@unique([tenantId, provider, externalId])
  @@index([tenantId])
}

// APPEND-ONLY (invariant #1): source transactions are never mutated; everything the user
// sees is derived. Money is integer minor units (invariant #4): amountMinor is pennies,
// never a float. The unique constraint makes ingestion idempotent.
model Transaction {
  id          String      @id @default(cuid())
  tenantId    String
  accountId   String
  account     BankAccount @relation(fields: [accountId], references: [id])
  externalId  String      // provider's id
  amountMinor Int         // integer minor units; negative = outflow
  currency    String      // ISO 4217
  bookedAt    DateTime
  description String
  raw         Json        // original payload, for audit/traceability
  ingestedAt  DateTime    @default(now())

  @@unique([tenantId, accountId, externalId]) // idempotency
  @@index([tenantId, accountId, bookedAt])
}

// OAuth grants for external providers — Xero today, the bank aggregator in Spec 2.
// Provider-keyed rather than Xero-specific: the aggregator grant has an identical shape,
// and a second near-duplicate table would be the only alternative.
//
// These rows are CREDENTIALS (invariant #7). Two consequences:
//   - Tokens are stored as ciphertext, never plaintext. The application encrypts with
//     AES-256-GCM before writing; keyVersion identifies the key so rotation does not
//     require re-authorising every tenant. The database never sees a usable token.
//   - RLS matters more here than anywhere else. A cross-tenant read of this table is not
//     a data leak, it is handing over the keys to another company's accounting system.
//
// Unlike Transaction this is NOT append-only: Xero rotates the refresh token on every
// refresh, so the row must be updatable in place.
model ProviderTokenGrant {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  provider Provider

  /// The provider's own org identifier — Xero's tenantId. Deliberately NOT named
  /// tenantId: that column is OUR customer, and conflating the two would be a
  /// cross-tenant bug waiting to happen.
  externalTenantId String?

  accessTokenCipher  Bytes
  refreshTokenCipher Bytes
  /// Which encryption key produced the ciphertext above. Lets keys rotate forward.
  keyVersion Int @default(1)

  expiresAt   DateTime // access token expiry
  scope       String // scopes actually granted, to detect a stale consent
  connections Json // provider's authorised orgs, verbatim
  connectedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, provider]) // one live grant per provider per tenant
  @@index([tenantId])
}
